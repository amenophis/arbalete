{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check",
      "detail": "Run every check listed in CONTRIBUTING.md",
      "type": "shell",
      "command": "mise run check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "app",
      "detail": "Bundle the app",
      "type": "shell",
      "command": "mise run app",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "run",
      "detail": "Build and run the app",
      "type": "shell",
      "command": "mise run run",
      "problemMatcher": ["$rustc"]
    }
  ]
}
