{
  // Search already skips what .gitignore lists.
  "files.watcherExclude": { "target/**": true, "ui/node_modules/**": true, "ui/dist/**": true },

  // Format on save only the languages that have a project formatter: the scripts in e2e/ and
  // perf/ follow no formatter's style.
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer", "editor.formatOnSave": true },
  "rust-analyzer.check.command": "clippy",

  // Biome's configuration is in ui/, not at the workspace root.
  "biome.configurationPath": "ui/biome.json",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
  },
  "[css]": { "editor.defaultFormatter": "biomejs.biome", "editor.formatOnSave": true },

  // The UI's TypeScript 7 ships no tsserver: the TypeScript 7 extension serves it.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "ui/node_modules/typescript"
}
