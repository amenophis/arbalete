{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "semanticCommits": "enabled",
  "mise": {
    "managerFilePatterns": [
      "/(^|/)\\.config/mise\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Dependency updates are build changes, never features or fixes in the release notes.",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": null
    },
    {
      "description": "The cef crate follows amenophis/cef-codecs' release (above), never on its own.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "cef"
      ],
      "enabled": false
    },
    {
      "description": "A new Chromium is for users to see: in the release notes, as a pull request of its own, never merged automatically.",
      "matchPackageNames": [
        "amenophis/cef-codecs"
      ],
      "semanticCommitType": "feat",
      "semanticCommitScope": "app",
      "commitMessageTopic": "Chromium",
      "labels": [
        "chromium"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "The CEF build Arbalete takes: a release of amenophis/cef-codecs, named in Cargo.toml. Proposed only once released there; .github/workflows/cef-crate.yml then moves the cef crate along.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Cargo\\.toml$/"
      ],
      "matchStrings": [
        "cef-codecs = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "amenophis/cef-codecs",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^cef-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-codecs\\.(?<build>\\d+)$"
    }
  ]
}
